# Cloudflare Pages - Cache headers for optimal performance

# HTML - short cache so updates deploy instantly
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Images - cache aggressively (1 year), they rarely change
/assets/artworks/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/assets/*.png
  Cache-Control: public, max-age=31536000, immutable

# Video - cache for 7 days
/assets/*.mp4
  Cache-Control: public, max-age=604800

# Security headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
