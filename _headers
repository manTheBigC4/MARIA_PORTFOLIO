# Cloudflare Pages Headers

# HTML - fresh validation so updates deploy instantly
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Static Assets - Images, PDFs, Logos (1 year immutable cache)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/gallery/*
  Cache-Control: public, max-age=31536000, immutable

/assets/gallery/floral/*
  Cache-Control: public, max-age=31536000, immutable

/assets/gallery/mina/*
  Cache-Control: public, max-age=31536000, immutable

/assets/gallery/exhibitions/*
  Cache-Control: public, max-age=31536000, immutable

/assets/gallery/botanical_landscape/*
  Cache-Control: public, max-age=31536000, immutable

/assets/docs/*
  Cache-Control: public, max-age=31536000, immutable

# Video media - 30 days cache with revalidation
/assets/*.mp4
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Security and Privacy Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
